{
  "name": "ilovemyofficeworks-desktop",
  "version": "1.0.0",
  "description": "ILoveMyOfficeWorks — 100% Private Client-Side PDF Toolkit (Windows Desktop)",
  "author": "Anshumaan Khare",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "npm run build --prefix ../client && electron-builder --win",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win",
    "dist:portable": "electron-builder --win portable",
    "dist:nsis": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8"
  }
}
